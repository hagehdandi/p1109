# Nama aplikasi yang tampil di header, judul tab, dan halaman masuk
APP_NAME=Dmails

# Domain email Anda. Alamat pengguna menjadi nama@MAIL_DOMAIN
MAIL_DOMAIN=dmails.local

# Server web (webmail + API)
HOST=0.0.0.0
PORT=3000

# Lokasi database SQLite & lampiran
DATA_DIR=data

# Izinkan pendaftaran akun baru dari halaman "Buat akun"
ALLOW_SIGNUP=true

# Buat akun & email contoh saat database masih kosong (matikan di produksi)
SEED_DEMO=true

# Set true bila situs diakses lewat HTTPS (cookie sesi hanya dikirim via HTTPS)
COOKIE_SECURE=false

# Kuota penyimpanan yang ditampilkan per pengguna (MB)
USER_QUOTA_MB=1024

# ---------------------------------------------------------------------------
# SMTP masuk (MX): menerima email dari internet untuk @MAIL_DOMAIN
# Di produksi gunakan port 25 (butuh hak akses) atau teruskan port 25 -> 2525
SMTP_ENABLED=true
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
SMTP_HOSTNAME=mail.dmails.local
# Sertifikat TLS opsional untuk STARTTLS
SMTP_TLS_KEY=
SMTP_TLS_CERT=

# ---------------------------------------------------------------------------
# Pengiriman keluar ke domain lain: relay | direct | disabled
#   relay    = lewat penyedia SMTP (disarankan: Mailgun, SendGrid, Amazon SES, dll.)
#   direct   = langsung ke server MX tujuan lewat port 25
#   disabled = hanya antar-pengguna di server ini
OUTBOUND_MODE=disabled
RELAY_HOST=
RELAY_PORT=587
RELAY_SECURE=false
RELAY_USER=
RELAY_PASS=

# DKIM opsional (disarankan untuk mode direct)
DKIM_SELECTOR=
DKIM_PRIVATE_KEY_FILE=
